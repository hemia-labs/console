{
  "extends": "../../apps/web/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../apps/web",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "*": [
        "node_modules/@types/*",
        "node_modules/*"
      ]
    },
    "typeRoots": [
      "../../apps/web/node_modules/@types"
    ],
    "incremental": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../apps/web/next-env.d.ts"
  ],
  "exclude": [
    "../../node_modules"
  ]
}
