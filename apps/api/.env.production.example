NODE_ENV=production
PORT=3016
APP_CORS_ORIGINS=https://console.hemia.cloud
APP_CORS_CREDENTIALS=true
HEMIA_ID_BASE_URL=https://api-id.hemia.cloud
HEMIA_ID_ADMIN_PREFIX=/api/v1
IDENTITY_ADMIN_CLIENT_SECRET=REPLACE_ON_SERVER
SSO_ISSUER=https://api-id.hemia.cloud
SSO_CLIENT_ID=console
SSO_CLIENT_SECRET=REPLACE_ON_SERVER
SSO_AUDIENCE=console-api
SSO_REDIRECT_URI=https://console.hemia.cloud/auth/callback
SSO_FRONTEND_URL=https://console.hemia.cloud
SSO_COOKIE_NAME=console_session
SSO_COOKIE_SECURE=true
SSO_SCOPE=openid profile email offline_access console.access
ACCESS_API_URL=https://api-access.hemia.cloud
ACCESS_JWKS_URI=https://api-access.hemia.cloud/.well-known/jwks.json
ACCESS_CLIENT_ID=console-access-admin
ACCESS_CLIENT_SECRET=REPLACE_ON_SERVER
ACCESS_AUDIENCE=access-api
LEGAL_API_URL=https://legal.hemia.cloud
BILLING_API_BASE_URL=https://billing.hemia.cloud/api/v1
PRODUCT_CODE=console
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ON_SERVER
# Assign a Redis DB dedicated to Console; confirm it is unused before provisioning.
REDIS_DB=0
