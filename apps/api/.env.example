NODE_ENV=development
PORT=3016

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false

HEMIA_ID_BASE_URL=http://localhost:3000
HEMIA_ID_ADMIN_PREFIX=/api/v1
HEMIA_ID_TIMEOUT_MS=5000
SSO_IDENTITY_ADMIN_SERVICE_SECRET=

# SSO login (@hemia/auth). SSO_CLIENT_ID / SSO_AUDIENCE are required in production.
# OAuth URLs are optional: si se omiten, se derivan de SSO_ISSUER (o HEMIA_ID_BASE_URL).
SSO_ISSUER=http://localhost:3000
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUDIENCE=
SSO_JWKS_URL=
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_REVOCATION_URL=
SSO_LOGOUT_URL=
SSO_REDIRECT_URI=http://localhost:3016/auth/callback
SSO_FRONTEND_URL=http://localhost:5176
SSO_SCOPE=openid profile email offline_access console.access
SSO_COOKIE_NAME=console_session
SSO_SESSION_TTL_SECONDS=604800
SSO_COOKIE_SECURE=false
ACCESS_API_URL=http://localhost:3019
ACCESS_JWKS_URI=
ACCESS_AUDIENCE=access-api
PRODUCT_CODE=console

# Redis (session store for @hemia/auth).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
